    "startNodeId": "n01",
    "nodes": {
      "n01": {
        "id": "n01",
        "text": "从店里出来，天已经开始暗了。她抱着纸袋走在旁边。",
        "nextNodeId": "n02"
      },
      "n02": {
        "id": "n02",
        "speakerId": "meguru",
        "text": "制作人，今天谢谢你。",
        "nextNodeId": "n03"
      },
      "n03": {
        "id": "n03",
        "speakerId": "meguru",
        "text": "……那个。下次，要是还有这种事的话……",
        "choices": [
          {
            "label": "下次也一起去",
            "nextNodeId": "n04a",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 3
              }
            ]
          },
          {
            "label": "先把这次的拍摄做好",
            "nextNodeId": "n04b",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 1
              }
            ]
          }
        ]
      },
      "n04a": {
        "id": "n04a",
        "speakerId": "meguru",
        "text": "真的？诶嘿嘿，那就说好了！",
        "nextNodeId": "n05"
      },
      "n04b": {
        "id": "n04b",
        "speakerId": "meguru",
        "text": "……也是哦！那我拍摄的时候，会加油的！",
        "nextNodeId": "n05"
      },
      "n05": {
        "id": "n05",
        "text": "她把纸袋抱得更紧了。路口的灯亮起来，映在她脸上。"
      }
    }
  },
