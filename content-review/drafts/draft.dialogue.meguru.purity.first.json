{
  "id": "draft.dialogue.meguru.purity.first",
  "kind": "dialogue",
  "title": "纯白 · 早到",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.meguru.purity.first",
  "payload": {
    "id": "dialogue.meguru.purity.first",
    "idolId": "meguru",
    "startNodeId": "n01",
    "nodes": {
      "n01": {
        "id": "n01",
        "text": "练习室。比集合时间早了将近一小时，里面却已经有人在拉伸。",
        "nextNodeId": "n02"
      },
      "n02": {
        "id": "n02",
        "text": "你说其他人好像还没来，问她平常就这么早吗。",
        "nextNodeId": "n03"
      },
      "n03": {
        "id": "n03",
        "speakerId": "meguru",
        "text": "今天是偶然！因为学校那边的安排结束得比较早。",
        "nextNodeId": "n04"
      },
      "n04": {
        "id": "n04",
        "speakerId": "meguru",
        "text": "你看你看，我的身体比之前更柔软了吧——！",
        "nextNodeId": "n05"
      },
      "n05": {
        "id": "n05",
        "text": "确实，腿能顺畅地抬起来了。你照实说了。",
        "nextNodeId": "n06"
      },
      "n06": {
        "id": "n06",
        "speakerId": "meguru",
        "text": "诶嘿嘿，谢谢夸奖！",
        "nextNodeId": "n07"
      },
      "n07": {
        "id": "n07",
        "speakerId": "meguru",
        "text": "啊，我想伸展一下，可以压着我的背吗？",
        "nextNodeId": "n08"
      },
      "n08": {
        "id": "n08",
        "text": "你说好，按住她的背。她数着拍子往下沉，呼吸很稳。",
        "nextNodeId": "n09"
      },
      "n09": {
        "id": "n09",
        "speakerId": "meguru",
        "text": "嗯，谢谢你！",
        "nextNodeId": "n10"
      },
      "n10": {
        "id": "n10",
        "speakerId": "meguru",
        "text": "说起来……制作人谈过恋爱吗？"
      }
    }
  },
  "annotations": [],
