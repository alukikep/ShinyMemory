{
  "id": "draft.dialogue.hiori.gap.first",
  "kind": "dialogue",
  "title": "灯织 · 千里的距离 · first",
  "status": "approved",
  "version": 1,
  "rootId": "draft.dialogue.hiori.gap.first",
  "payload": {
    "id": "dialogue.hiori.gap.first",
    "idolId": "hiori",
    "startNodeId": "n01",
    "nodes": {
      "n01": {
        "id": "n01",
        "text": "商业街的橱窗前站了几个人。玻璃里是新一期的海报。",
        "nextNodeId": "n02"
      },
      "n02": {
        "id": "n02",
        "speakerId": "hiori",
        "text": "……真乃的广告牌。",
        "nextNodeId": "n03"
      },
      "n03": {
        "id": "n03",
        "speakerId": "hiori",
        "text": "巡也在。杂志的样刊前天寄到事务所了。",
        "nextNodeId": "n04"
      },
      "n04": {
        "id": "n04",
        "speakerId": "hiori",
        "text": "个人的工作，两个人都在努力呢。",
        "nextNodeId": "n05"
      },
      "n05": {
        "id": "n05",
        "text": "旁边的两个女生在讨论海报上的发型。她听着，也接了一句。",
        "nextNodeId": "n06"
      },
      "n06": {
        "id": "n06",
        "speakerId": "hiori",
        "text": "我懂。那个发型很适合巡。……杂志我也买吧。",
        "nextNodeId": "n07"
      },
      "n07": {
        "id": "n07",
        "text": "她说完就安静了。橱窗的灯把她的侧脸照得很白。",
        "choices": [
          {
            "label": "你注意到了。只是没说。",
            "nextNodeId": "n08a",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 3
              }
            ]
          },
          {
            "label": "什么也不说，陪她站一会儿",
            "nextNodeId": "n08b",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 3
              },
              {
                "kind": "flag",
                "key": "hiori_stood_quietly",
                "value": true
              }
            ]
          },
          {
            "label": "她们确实很厉害",
            "nextNodeId": "n08c",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 1
              }
            ]
          }
        ]
      },
      "n08a": {
        "id": "n08a",
        "speakerId": "hiori",
        "text": "……你今天说话很讨厌。",
        "nextNodeId": "n09"
      },
      "n08b": {
        "id": "n08b",
        "text": "她没说话。过了很久，才低声开口。",
        "nextNodeId": "n09"
      },
      "n08c": {
        "id": "n08c",
        "speakerId": "hiori",
        "text": "是啊。",
        "nextNodeId": "n09"
      },
      "n09": {
        "id": "n09",
        "speakerId": "hiori",
        "text": "今天是经常看到两人名字的日子呢。",
        "nextNodeId": "n10"
      },
      "n10": {
        "id": "n10",
        "speakerId": "hiori",
        "text": "\"只是\"今天吗。……其实并不是这样的。是我没有注意到。",
        "nextNodeId": "n11"
      },
      "n11": {
        "id": "n11",
        "text": "她转过身，往车站的方向走，走了两步停下。",
        "nextNodeId": "n12"
      },
      "n12": {
        "id": "n12",
        "speakerId": "hiori",
        "text": "……我回去练习了。",
        "effects": [
          {
            "kind": "var",
            "key": "hiori.gap",
            "op": "set",
            "value": 1
          }
        ]
      }
    }
  },
