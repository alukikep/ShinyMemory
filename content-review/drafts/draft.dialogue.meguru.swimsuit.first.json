{
  "id": "draft.dialogue.meguru.swimsuit.first",
  "kind": "dialogue",
  "title": "泳装的颜色 · 邀约",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.meguru.swimsuit.first",
  "payload": {
    "id": "dialogue.meguru.swimsuit.first",
    "idolId": "meguru",
    "startNodeId": "n01",
    "nodes": {
      "n01": {
        "id": "n01",
        "text": "事务所的桌上摊着一本杂志。封面上写着「新人偶像特集」。",
        "nextNodeId": "n02"
      },
      "n02": {
        "id": "n02",
        "speakerId": "meguru",
        "text": "新人偶像特集？",
        "nextNodeId": "n03"
      },
      "n03": {
        "id": "n03",
        "speakerId": "meguru",
        "text": "这个杂志！是便利店一直有的那个！",
        "nextNodeId": "n04"
      },
      "n04": {
        "id": "n04",
        "text": "对方希望她穿自己的衣服来。除此之外，还会拍一组泳装照。",
        "nextNodeId": "n05"
      },
      "n05": {
        "id": "n05",
        "speakerId": "meguru",
        "text": "有学校穿的泳装……嗯——不过要拍照的话还是可爱的泳装更好吧！？",
        "nextNodeId": "n06"
      },
      "n06": {
        "id": "n06",
        "speakerId": "meguru",
        "text": "那就得去买泳装了，制作人！",
        "choices": [
          {
            "label": "好，那就出门吧",
            "nextNodeId": "n07",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 1
              }
            ]
          },
          {
            "label": "拍摄前不紧张吗",
            "nextNodeId": "n07b",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 3
              }
            ]
          }
        ]
      },
      "n07": {
        "id": "n07",
        "speakerId": "meguru",
        "text": "好耶——！谢谢你，制作人！要选什么泳装好呢，诶嘿嘿！"
      },
      "n07b": {
        "id": "n07b",
        "speakerId": "meguru",
        "text": "诶？……有一点。不过现在先想着买泳装的事！",
        "nextNodeId": "n07c"
      },
      "n07c": {
        "id": "n07c",
        "speakerId": "meguru",
        "text": "要选什么泳装好呢，诶嘿嘿！"
      }
    }
  },
