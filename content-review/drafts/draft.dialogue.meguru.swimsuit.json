{
  "id": "draft.dialogue.meguru.swimsuit",
  "kind": "dialogue",
  "title": "泳装的颜色",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.meguru.swimsuit",
  "payload": {
    "id": "dialogue.meguru.swimsuit",
    "idolId": "meguru",
    "startNodeId": "1-n01",
    "nodes": {
      "1-n01": {
        "id": "1-n01",
        "text": "事务所的桌上摊着一本杂志。封面上写着「新人偶像特集」。",
        "nextNodeId": "1-n02"
      },
      "1-n02": {
        "id": "1-n02",
        "speakerId": "meguru",
        "text": "新人偶像特集？",
        "nextNodeId": "1-n03"
      },
      "1-n03": {
        "id": "1-n03",
        "speakerId": "meguru",
        "text": "这个杂志！是便利店一直有的那个！",
        "nextNodeId": "1-n04"
      },
      "1-n04": {
        "id": "1-n04",
        "text": "对方希望她穿自己的衣服来。除此之外，还会拍一组泳装照。",
        "nextNodeId": "1-n05"
      },
      "1-n05": {
        "id": "1-n05",
        "speakerId": "meguru",
        "text": "有学校穿的泳装……嗯——不过要拍照的话还是可爱的泳装更好吧！？",
        "nextNodeId": "1-n06"
      },
      "1-n06": {
        "id": "1-n06",
        "speakerId": "meguru",
        "text": "有学校穿的泳装……嗯——不过要拍照的话还是可爱的泳装更好吧！？那就得去买泳装了，制作人！",
        "nextNodeId": "1-n07"
      },
      "1-n07": {
        "id": "1-n07",
        "speakerId": "meguru",
        "text": "好耶——！谢谢你，制作人！要选什么泳装好呢，诶嘿嘿！",
        "nextNodeId": "2-n01"
      },
      "2-n01": {
        "id": "2-n01",
        "text": "店里整整一面墙都是泳装。她从这头走到那头，又走回来。",
        "nextNodeId": "2-n02"
      },
      "2-n02": {
        "id": "2-n02",
        "speakerId": "meguru",
        "text": "哇——……！每一件都很可爱啊——……！",
        "nextNodeId": "2-n03"
      },
      "2-n03": {
        "id": "2-n03",
        "speakerId": "meguru",
        "text": "有花图案和蝴蝶结……制作人觉得哪种比较好？",
        "nextNodeId": "2-n04"
      },
      "2-n04": {
        "id": "2-n04",
        "text": "你说，不是要选巡喜欢的款式吗。她愣了一下，然后笑起来。",
        "nextNodeId": "2-n05"
      },
      "2-n05": {
        "id": "2-n05",
        "speakerId": "meguru",
        "text": "我和朋友买东西的时候，一边聊天一边逛街超开心的。",
        "nextNodeId": "2-n06"
      },
      "2-n06": {
        "id": "2-n06",
        "speakerId": "meguru",
        "text": "之前也有过聊到入迷结果什么都没买就结束了行程的情况！诶嘿嘿。",
        "nextNodeId": "2-n07"
      },
      "2-n07": {
        "id": "2-n07",
        "speakerId": "meguru",
        "text": "……不过能上杂志的只有一件吧……嗯——……好难选——！",
        "nextNodeId": "2-n08"
      },
      "2-n08": {
        "id": "2-n08",
        "speakerId": "meguru",
        "text": "我要怎么办啊，制作人……！",
        "nextNodeId": "3-n01"
      },
      "3-n01": {
        "id": "3-n01",
        "speakerId": "meguru",
        "text": "我要怎么办啊，制作人……！",
        "choices": [
          {
            "label": "看起来精神的会不会更适合你",
            "nextNodeId": "3-n02a",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "expression",
                "tier": 1
              }
            ]
          },
          {
            "label": "试试搭配吧",
            "nextNodeId": "3-n02b",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 1
              }
            ]
          },
          {
            "label": "交给运气来吧",
            "nextNodeId": "3-n02c",
            "effects": [
              {
                "kind": "sharedStat",
                "stat": "stress",
                "delta": -2
              }
            ]
          }
        ]
      },
      "3-n02a": {
        "id": "3-n02a",
        "speakerId": "meguru",
        "text": "比如……这样的？",
        "nextNodeId": "3-n03a"
      },
      "3-n03a": {
        "id": "3-n03a",
        "speakerId": "meguru",
        "text": "那这件呢……！？……会不会有点成熟？",
        "nextNodeId": "3-n04a"
      },
      "3-n04a": {
        "id": "3-n04a",
        "speakerId": "meguru",
        "text": "不是，虽然我很想变得适合穿这种，但还是等再大点吧！",
        "nextNodeId": "3-n05"
      },
      "3-n02b": {
        "id": "3-n02b",
        "speakerId": "meguru",
        "text": "诶？什么意思……啊！那样也可以啊！",
        "nextNodeId": "3-n03b"
      },
      "3-n03b": {
        "id": "3-n03b",
        "speakerId": "meguru",
        "text": "发饰或者项链之类的……把我喜欢的都搭配起来，一定会很开心！",
        "nextNodeId": "3-n05"
      },
      "3-n02c": {
        "id": "3-n02c",
        "speakerId": "meguru",
        "text": "啊哈哈，好像游戏！那……这件！",
        "nextNodeId": "3-n03c"
      },
      "3-n03c": {
        "id": "3-n03c",
        "speakerId": "meguru",
        "text": "哇，好时尚……！可是奇怪……好像有点大了。",
        "nextNodeId": "3-n04c"
      },
      "3-n04c": {
        "id": "3-n04c",
        "speakerId": "meguru",
        "text": "……这么大的尺寸应该比较适合制作人了——",
        "nextNodeId": "3-n05"
      },
      "3-n05": {
        "id": "3-n05",
        "text": "最后还是得挑一件合适的。她把范围一点点缩小，手里剩下三件。",
        "nextNodeId": "3-n06"
      },
      "3-n06": {
        "id": "3-n06",
        "speakerId": "meguru",
        "text": "真是的——！能全部都穿到就好了——！",
        "nextNodeId": "4-n01"
      },
      "4-n01": {
        "id": "4-n01",
        "text": "从店里出来，天已经开始暗了。她抱着纸袋走在旁边。",
        "nextNodeId": "4-n02"
      },
      "4-n02": {
        "id": "4-n02",
        "speakerId": "meguru",
        "text": "制作人，今天谢谢你。",
        "nextNodeId": "4-n03"
      },
      "4-n03": {
        "id": "4-n03",
        "speakerId": "meguru",
        "text": "……那个。下次，要是还有这种事的话……",
        "nextNodeId": "4-n04a"
      },
      "4-n04a": {
        "id": "4-n04a",
        "speakerId": "meguru",
        "text": "真的？诶嘿嘿，那就说好了！",
        "nextNodeId": "4-n05"
      },
      "4-n05": {
        "id": "4-n05",
        "text": "她把纸袋抱得更紧了。路口的灯亮起来，映在她脸上。"
      }
    }
  },
  "annotations": [],
