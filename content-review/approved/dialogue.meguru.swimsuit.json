{
  "id": "dialogue.meguru.swimsuit",
  "kind": "dialogue",
  "title": "泳装的颜色",
  "status": "approved",
  "version": 2,
  "rootId": "dialogue.meguru.swimsuit",
  "payload": {
    "id": "dialogue.meguru.swimsuit",
    "idolId": "meguru",
    "startNodeId": "1-01",
    "nodes": {
      "1-01": {
        "id": "1-01",
        "text": "这是一本叫新人偶像特集的杂志。你先看看。",
        "nextNodeId": "1-02",
        "speakerId": "producer"
      },
      "1-02": {
        "id": "1-02",
        "speakerId": "meguru",
        "text": "这个杂志！便利店经常有卖的那种！",
        "nextNodeId": "1-03"
      },
      "1-03": {
        "id": "1-03",
        "speakerId": "meguru",
        "text": "哇，不同的人感觉完全不一样！大家的衣服也都好可爱——！",
        "nextNodeId": "1-04"
      },
      "1-04": {
        "id": "1-04",
        "text": "这本杂志的方针，好像是重视偶像的个性。",
        "nextNodeId": "1-05",
        "speakerId": "producer"
      },
      "1-05": {
        "id": "1-05",
        "speakerId": "meguru",
        "text": "好厉害！！好期待啊……！",
        "nextNodeId": "1-06"
      },
      "1-06": {
        "id": "1-06",
        "text": "还有，服装那边说想用巡的私服。",
        "nextNodeId": "1-07",
        "speakerId": "producer"
      },
      "1-07": {
        "id": "1-07",
        "text": "平时的衣服我觉得挺好，但也有泳装的镜头。你有吗？",
        "nextNodeId": "1-08",
        "speakerId": "producer"
      },
      "1-08": {
        "id": "1-08",
        "speakerId": "meguru",
        "text": "学校用的那种有……嗯——不过要拍照的话，还是可爱的泳装比较好吧！？",
        "nextNodeId": "1-09"
      },
      "1-09": {
        "id": "1-09",
        "speakerId": "meguru",
        "text": "那得去买泳装才行，制作人！",
        "nextNodeId": "1-10"
      },
      "1-10": {
        "id": "1-10",
        "text": "好，那就出去一趟吧。课程之后的安排我来定。",
        "nextNodeId": "1-11",
        "speakerId": "producer"
      },
      "1-11": {
        "id": "1-11",
        "speakerId": "meguru",
        "text": "好耶——！谢谢你，制作人！要挑什么样的呢，诶嘿嘿！",
        "nextNodeId": "1-12"
      },
      "1-12": {
        "id": "1-12",
        "speakerId": "meguru",
        "text": "制作人，来这边来这边！好多种泳装——",
        "nextNodeId": "1-13"
      },
      "1-13": {
        "id": "1-13",
        "speakerId": "meguru",
        "text": "哇——……！每一件都可爱啊——……！",
        "nextNodeId": "1-14"
      },
      "1-14": {
        "id": "1-14",
        "speakerId": "meguru",
        "text": "有花图案的、还有蝴蝶结……制作人觉得哪种好？",
        "nextNodeId": "1-15"
      },
      "1-15": {
        "id": "1-15",
        "text": "不是该选巡自己喜欢的吗？",
        "nextNodeId": "1-16",
        "speakerId": "producer"
      },
      "1-16": {
        "id": "1-16",
        "speakerId": "meguru",
        "text": "和朋友逛街的时候，一边聊天一边看，超开心的。",
        "nextNodeId": "1-17"
      },
      "1-17": {
        "id": "1-17",
        "speakerId": "meguru",
        "text": "也有过聊得太投入，什么都没买就回家了！诶嘿嘿。",
        "nextNodeId": "1-18"
      },
      "1-18": {
        "id": "1-18",
        "speakerId": "meguru",
        "text": "……不过能上杂志的只有一件吧……嗯——好难选——！",
        "nextNodeId": "1-19"
      },
      "1-19": {
        "id": "1-19",
        "speakerId": "meguru",
        "text": "怎么办啊，制作人……！",
        "choices": [
          {
            "label": "有精神的会不会更适合你",
            "nextNodeId": "2-01",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "expression",
                "tier": 1
              }
            ]
          },
          {
            "label": "试试搭配吧",
            "nextNodeId": "3-01",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 1
              }
            ]
          },
          {
            "label": "交给运气来吧",
            "nextNodeId": "4-01",
            "effects": [
              {
                "kind": "sharedStat",
                "stat": "stress",
                "delta": -2
              }
            ]
          }
        ]
      },
      "2-01": {
        "id": "2-01",
        "text": "有精神的会不会更适合你？",
        "nextNodeId": "2-02",
        "speakerId": "producer"
      },
      "2-02": {
        "id": "2-02",
        "speakerId": "meguru",
        "text": "比如……这样的？",
        "nextNodeId": "2-03"
      },
      "2-03": {
        "id": "2-03",
        "speakerId": "meguru",
        "text": "哇！这个好！好可爱……！",
        "nextNodeId": "2-04"
      },
      "2-04": {
        "id": "2-04",
        "speakerId": "meguru",
        "text": "那这件呢……！？会不会有点成熟？",
        "nextNodeId": "2-05"
      },
      "2-05": {
        "id": "2-05",
        "speakerId": "meguru",
        "text": "不是，虽然想变得适合穿这种，但还是等再大一点吧！",
        "nextNodeId": "2-06"
      },
      "2-06": {
        "id": "2-06",
        "speakerId": "meguru",
        "text": "嗯！只要一下子哦？"
      },
      "3-01": {
        "id": "3-01",
        "text": "试试搭配吧。",
        "nextNodeId": "3-02",
        "speakerId": "producer"
      },
      "3-02": {
        "id": "3-02",
        "speakerId": "meguru",
        "text": "诶？什么意思……啊！那样也可以啊！",
        "nextNodeId": "3-03"
      },
      "3-03": {
        "id": "3-03",
        "text": "发饰啊项链之类的……",
        "nextNodeId": "3-04",
        "speakerId": "producer"
      },
      "3-04": {
        "id": "3-04",
        "speakerId": "meguru",
        "text": "嗯！把喜欢的都配起来，一定会很开心！",
        "nextNodeId": "3-05"
      },
      "3-05": {
        "id": "3-05",
        "speakerId": "meguru",
        "text": "谢谢你制作人！好，搭配搭配！我看看……"
      },
      "4-01": {
        "id": "4-01",
        "text": "试试闭上眼睛随手抓一件，赌在偶然的相遇上如何？",
        "nextNodeId": "4-02",
        "speakerId": "producer"
      },
      "4-02": {
        "id": "4-02",
        "speakerId": "meguru",
        "text": "啊哈哈，好像游戏！那——……好——……这件！",
        "nextNodeId": "4-03"
      },
      "4-03": {
        "id": "4-03",
        "speakerId": "meguru",
        "text": "哇，好时尚……！可是奇怪……好像有点大。",
        "nextNodeId": "4-04"
      },
      "4-04": {
        "id": "4-04",
        "speakerId": "meguru",
        "text": "嗯，好像没有适合我的尺寸。",
        "nextNodeId": "4-05"
      },
      "4-05": {
        "id": "4-05",
        "speakerId": "meguru",
        "text": "……这么大的尺寸，应该比较适合制作人了——",
        "nextNodeId": "4-06"
      },
      "4-06": {
        "id": "4-06",
        "text": "喂，别往我身上比。",
        "nextNodeId": "4-07",
        "speakerId": "producer"
      },
      "4-07": {
        "id": "4-07",
        "speakerId": "meguru",
        "text": "诶嘿嘿，开个玩笑！",
        "nextNodeId": "4-08"
      },
      "4-08": {
        "id": "4-08",
        "speakerId": "meguru",
        "text": "那就挑一些好看的，再从里面选合适的尺寸吧。",
        "nextNodeId": "4-09"
      },
      "4-09": {
        "id": "4-09",
        "speakerId": "meguru",
        "text": "对哦！太多会困扰……一点点缩小范围确实更好！",
        "nextNodeId": "4-10"
      },
      "4-10": {
        "id": "4-10",
        "speakerId": "meguru",
        "text": "真是的——！能全部都穿到就好了——！"
      }
    }
  },
