{
  "id": "draft.dialogue.meguru.coffee.worry",
  "kind": "dialogue",
  "title": "咖啡 · 不是你的错",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.meguru.coffee.worry",
  "payload": {
    "id": "dialogue.meguru.coffee.worry",
    "idolId": "meguru",
    "startNodeId": "n01",
    "nodes": {
      "n01": {
        "id": "n01",
        "speakerId": "meguru",
        "text": "难道……因为我才这么忙？",
        "nextNodeId": "n02"
      },
      "n02": {
        "id": "n02",
        "speakerId": "meguru",
        "text": "又来看我练习，又来陪我说话……",
        "nextNodeId": "n03"
      },
      "n03": {
        "id": "n03",
        "text": "她低着头，手指在毯子边缘来回捏。",
        "choices": [
          {
            "label": "不是你的错",
            "nextNodeId": "n04a",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 1
              }
            ]
          },
          {
            "label": "我很开心，没问题的",
            "nextNodeId": "n04b",
            "effects": [
              {
                "kind": "sharedStat",
                "stat": "stress",
                "delta": -2
              }
            ]
          },
          {
            "label": "其实我有休息",
            "nextNodeId": "n04c",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "insight",
                "tier": 1
              }
            ]
          }
        ]
      },
      "n04a": {
        "id": "n04a",
        "text": "你说很抱歉让她这么想。她抬起头。",
        "nextNodeId": "n05"
      },
      "n04b": {
        "id": "n04b",
        "speakerId": "meguru",
        "text": "开心是开心……可是那样也不行啊！",
        "nextNodeId": "n05"
      },
      "n04c": {
        "id": "n04c",
        "speakerId": "meguru",
        "text": "骗人。桌上都是文件。",
        "nextNodeId": "n05"
      },
      "n05": {
        "id": "n05",
        "text": "你说，巡每天都能坚持完成那么严格的课程吧。站在舞台上发光是她的工作，在背后支持她是你的工作。",
        "nextNodeId": "n06"
      },
      "n06": {
        "id": "n06",
        "speakerId": "meguru",
        "text": "嗯……",
        "nextNodeId": "n07"
      },
      "n07": {
        "id": "n07",
        "text": "你说不过会尽量不让她担心。她用力点头。",
        "nextNodeId": "n08"
      },
      "n08": {
        "id": "n08",
        "speakerId": "meguru",
        "text": "嗯！要快点好好休息……不是因为我在担心，这是为了制作人的身体哦？"
      }
    }
  },
