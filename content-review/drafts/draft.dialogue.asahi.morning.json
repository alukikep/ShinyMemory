{
  "id": "draft.dialogue.asahi.morning",
  "kind": "dialogue",
  "title": "清晨的练习室有人在呼吸",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.asahi.morning",
  "payload": {
    "id": "dialogue.asahi.morning",
    "idolId": "asahi",
    "startNodeId": "1",
    "nodes": {
      "1": {
        "id": "1",
        "speakerId": "asahi",
        "text": "哈……呼……",
        "nextNodeId": "2"
      },
      "2": {
        "id": "2",
        "speakerId": "producer",
        "text": "あさひ，早上好。",
        "nextNodeId": "3"
      },
      "3": {
        "id": "3",
        "speakerId": "asahi",
        "text": "呼——……",
        "nextNodeId": "4"
      },
      "4": {
        "id": "4",
        "speakerId": "asahi",
        "text": "制作人先生，早上好。",
        "nextNodeId": "5"
      },
      "5": {
        "id": "5",
        "speakerId": "producer",
        "text": "一大早就辛苦了。今天格外有干劲啊。",
        "nextNodeId": "6"
      },
      "6": {
        "id": "6",
        "speakerId": "asahi",
        "text": "那当然！因为今天制作人先生要看我上课！",
        "nextNodeId": "7"
      },
      "7": {
        "id": "7",
        "speakerId": "producer",
        "text": "那我平时也一直在看——",
        "nextNodeId": "8"
      },
      "8": {
        "id": "8",
        "speakerId": "asahi",
        "text": "——今天不一样。",
        "nextNodeId": "9"
      },
      "9": {
        "id": "9",
        "speakerId": "producer",
        "text": "あさひ？",
        "nextNodeId": "10"
      },
      "10": {
        "id": "10",
        "speakerId": "asahi",
        "text": "制作人先生，今天只要……看着就好。",
        "nextNodeId": "11"
      },
      "11": {
        "id": "11",
        "speakerId": "asahi",
        "text": "我要跳了！",
        "nextNodeId": "12"
      },
      "12": {
        "id": "12",
        "speakerId": "asahi",
        "text": "吸——……",
        "nextNodeId": "13"
      },
      "13": {
        "id": "13",
        "speakerId": "asahi",
        "text": "！",
        "nextNodeId": "14"
      },
      "14": {
        "id": "14",
        "speakerId": "asahi",
        "text": "哈——……制作人先生，怎么样？",
        "nextNodeId": "15"
      },
      "15": {
        "id": "15",
        "speakerId": "producer",
        "text": "（……说不出来。刚才那一段，比之前任何一次都干净。）",
        "nextNodeId": "16"
      },
      "16": {
        "id": "16",
        "speakerId": "producer",
        "text": "……很好。真的。",
        "nextNodeId": "17"
      },
      "17": {
        "id": "17",
        "speakerId": "asahi",
        "text": "嘿嘿……那我，还能跳得更好！",
        "nextNodeId": "18"
      },
      "18": {
        "id": "18",
        "speakerId": "producer",
        "text": "（她不是不服输，是\"还能更有趣\"吧。）",
        "nextNodeId": "19"
      },
      "19": {
        "id": "19",
        "speakerId": "asahi",
        "text": "那，再来一次！"
      }
    }
  },
