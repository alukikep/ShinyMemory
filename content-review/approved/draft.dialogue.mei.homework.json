      "101": {
        "id": "101",
        "speakerId": "producer",
        "text": "嗯。知道要问什么，再读就不会迷路。",
        "nextNodeId": "102"
      },
      "102": {
        "id": "102",
        "speakerId": "mei",
        "text": "哦～……原来是这样。那うち试试。"
      },
      "110": {
        "id": "110",
        "speakerId": "mei",
        "text": "简单一点的……有啊，这个。",
        "nextNodeId": "111"
      },
      "111": {
        "id": "111",
        "speakerId": "producer",
        "text": "嗯，从那个开始。",
        "nextNodeId": "112"
      },
      "112": {
        "id": "112",
        "speakerId": "mei",
        "text": "好～那うち先做这个。"
      },
      "120": {
        "id": "120",
