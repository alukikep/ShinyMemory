{
  "id": "draft.dialogue.luca.first",
  "kind": "dialogue",
  "title": "把便当挂在她家门把上",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.luca.first",
  "payload": {
    "id": "dialogue.luca.first",
    "idolId": "luca",
    "startNodeId": "1",
    "nodes": {
      "1": {
        "id": "1",
        "text": "公寓三楼。走廊尽头的门关着，门牌擦得很干净，底下的信箱塞满了广告纸。",
        "nextNodeId": "2"
      },
      "2": {
        "id": "2",
        "text": "屋里没有灯。昨天挂上去的便当还在门把上，一动没动。",
        "nextNodeId": "3"
      },
      "3": {
        "id": "3",
        "speakerId": "producer",
        "text": "……",
        "nextNodeId": "4"
      },
      "4": {
        "id": "4",
        "speakerId": "producer",
        "text": "……放在这里了。今天的是加热就能吃的。",
        "nextNodeId": "5"
      },
      "5": {
        "id": "5",
        "text": "门里没有声音。过了一会儿，门把轻轻动了一下。",
        "nextNodeId": "6"
      },
      "6": {
        "id": "6",
        "speakerId": "luca",
        "text": "……食べ物…………？",
        "nextNodeId": "7"
      },
      "7": {
        "id": "7",
        "text": "门开了一条缝。她站在里面，头发乱着，眼睛下面一圈青。",
        "nextNodeId": "8"
      },
      "8": {
        "id": "8",
        "speakerId": "luca",
        "text": "な…………",
        "nextNodeId": "9"
      },
      "9": {
        "id": "9",
        "speakerId": "luca",
        "text": "…………んだよ…………你……………………",
        "nextNodeId": "10"
      },
      "10": {
        "id": "10",
        "speakerId": "producer",
        "text": "……约好了要给你送饭。",
        "nextNodeId": "11"
      },
      "11": {
        "id": "11",
        "speakerId": "luca",
        "text": "………………约好────────？",
        "nextNodeId": "12"
      },
      "12": {
        "id": "12",
        "speakerId": "producer",
        "text": "……嗯。你以前的经纪人，临走前拜托我的。",
        "nextNodeId": "13"
      },
      "13": {
        "id": "13",
        "speakerId": "luca",
        "text": "……",
        "nextNodeId": "14"
      },
      "14": {
        "id": "14",
        "speakerId": "luca",
        "text": "……是她说的？",
        "nextNodeId": "15"
      },
      "15": {
        "id": "15",
        "speakerId": "producer",
        "text": "她说，一直到出发前都在担心你。",
        "nextNodeId": "16"
      },
      "16": {
        "id": "16",
        "speakerId": "producer",
        "text": "还说……对不起你。",
        "nextNodeId": "17"
      },
      "17": {
        "id": "17",
        "speakerId": "luca",
        "text": "………………",
        "nextNodeId": "18"
      },
      "18": {
        "id": "18",
        "speakerId": "luca",
        "text": "哈────！",
        "nextNodeId": "19"
      },
      "19": {
        "id": "19",
        "speakerId": "luca",
        "text": "关你什么事啊，你这家伙……！",
        "nextNodeId": "20"
      },
      "20": {
        "id": "20",
        "speakerId": "producer",
        "text": "……是有关系。",
        "nextNodeId": "21"
      },
      "21": {
        "id": "21",
        "speakerId": "producer",
        "text": "希望你能再站上舞台的人，不止她一个。",
        "nextNodeId": "22"
      },
      "22": {
        "id": "22",
        "speakerId": "luca",
        "text": "……",
        "nextNodeId": "23"
      },
      "23": {
        "id": "23",
        "speakerId": "luca",
        "text": "滚………………！",
        "nextNodeId": "24"
      },
      "24": {
        "id": "24",
        "speakerId": "luca",
        "text": "滚，滚，滚，滚，滚──────────",
        "nextNodeId": "25"
      },
      "25": {
        "id": "25",
        "text": "门关上了。便当在门把上晃了两下，停住。",
        "nextNodeId": "26"
      },
      "26": {
        "id": "26",
        "speakerId": "producer",
        "text": "……我还会来的。",
        "nextNodeId": "27"
      },
      "27": {
        "id": "27",
        "text": "没有回答。但门后面，有很轻的、像喘气一样的声音。"
      }
    }
  },
  "annotations": [],
  "createdAt": "2026-11-01T09:00:00.000Z",
  "updatedAt": "2026-11-01T09:00:00.000Z",
