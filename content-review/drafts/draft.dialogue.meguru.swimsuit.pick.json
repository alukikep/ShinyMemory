      "n01": {
        "id": "n01",
        "speakerId": "meguru",
        "text": "我要怎么办啊，制作人……！",
        "choices": [
          {
            "label": "看起来精神的会不会更适合你",
            "nextNodeId": "n02a",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "expression",
                "tier": 1
              }
            ]
          },
          {
            "label": "试试搭配吧",
            "nextNodeId": "n02b",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 3
              }
            ]
          },
          {
            "label": "交给运气来吧",
            "nextNodeId": "n02c",
            "effects": [
              {
                "kind": "sharedStat",
                "stat": "stress",
                "delta": -3
              }
            ]
          }
        ]
      },
      "n02a": {
        "id": "n02a",
        "speakerId": "meguru",
        "text": "比如……这样的？",
        "nextNodeId": "n03a"
      },
      "n03a": {
        "id": "n03a",
        "speakerId": "meguru",
        "text": "那这件呢……！？……会不会有点成熟？",
        "nextNodeId": "n04a"
      },
      "n04a": {
        "id": "n04a",
        "speakerId": "meguru",
        "text": "不是，虽然我很想变得适合穿这种，但还是等再大点吧！",
        "nextNodeId": "n05"
      },
      "n02b": {
        "id": "n02b",
        "speakerId": "meguru",
        "text": "诶？什么意思……啊！那样也可以啊！",
        "nextNodeId": "n03b"
      },
      "n03b": {
        "id": "n03b",
        "speakerId": "meguru",
        "text": "发饰或者项链之类的……把我喜欢的都搭配起来，一定会很开心！",
        "nextNodeId": "n05"
      },
      "n02c": {
        "id": "n02c",
        "speakerId": "meguru",
        "text": "啊哈哈，好像游戏！那……这件！",
        "nextNodeId": "n03c"
      },
      "n03c": {
        "id": "n03c",
        "speakerId": "meguru",
        "text": "哇，好时尚……！可是奇怪……好像有点大了。",
        "nextNodeId": "n04c"
      },
      "n04c": {
        "id": "n04c",
        "speakerId": "meguru",
        "text": "……这么大的尺寸应该比较适合制作人了——",
        "nextNodeId": "n05"
      },
      "n05": {
        "id": "n05",
        "text": "最后还是得挑一件合适的。她把范围一点点缩小，手里剩下三件。",
        "nextNodeId": "n06"
      },
      "n06": {
        "id": "n06",
        "speakerId": "meguru",
        "text": "真是的——！能全部都穿到就好了——！"
      }
    }
  },
