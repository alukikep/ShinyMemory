{
  "name": "shiny-memory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "review": "vite --open /review.html --port 5174",
    "content:validate": "tsx tools/validateContent.ts",
    "build": "tsc --noEmit && npm run content:validate && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "acceptance": "npm test && npm run build && playwright test",
    "acceptance:review": "npm run build && playwright test -c playwright.review.config.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
