{
  "id": "draft.dialogue.meguru.stars.photo",
  "kind": "dialogue",
  "title": "星空 · 拍不下来",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.meguru.stars.photo",
  "payload": {
    "id": "dialogue.meguru.stars.photo",
    "idolId": "meguru",
    "startNodeId": "n01",
    "nodes": {
      "n01": {
        "id": "n01",
        "text": "你说和平常没什么两样吧，然后补了一句是在夸她。",
        "nextNodeId": "n02"
      },
      "n02": {
        "id": "n02",
        "speakerId": "meguru",
        "text": "这么认真的表情说这些，我有点害羞了……不过……谢谢你！",
        "nextNodeId": "n03"
      },
      "n03": {
        "id": "n03",
        "speakerId": "meguru",
        "text": "到现在发生的这么多事，对我来说全部都是不想忘记的重要的回忆……",
        "nextNodeId": "n04"
      },
      "n04": {
        "id": "n04",
        "speakerId": "meguru",
        "text": "今后也拜托你了，我最喜欢你了，制作人！",
        "nextNodeId": "n05"
      },
      "n05": {
        "id": "n05",
        "text": "她说完就往前跑。你说跑起来很危险。",
        "nextNodeId": "n06"
      },
      "n06": {
        "id": "n06",
        "speakerId": "meguru",
        "text": "嗯，我会注意！稍微等一下……！",
        "nextNodeId": "n07"
      },
      "n07": {
        "id": "n07",
        "text": "她举起手机，对着天空。过了一会儿放下来。",
        "nextNodeId": "n08"
      },
      "n08": {
        "id": "n08",
        "speakerId": "meguru",
        "text": "……啊——，好像不行啊。",
        "nextNodeId": "n09"
      },
      "n09": {
        "id": "n09",
        "speakerId": "meguru",
        "text": "我就是想拍今晚的星空，可是手机的镜头好像拍不出来。",
        "nextNodeId": "n10"
      },
      "n10": {
        "id": "n10",
        "speakerId": "meguru",
        "text": "工作和课程虽然也一样，但是我还想记住更多这种什么都没有的日子。",
        "nextNodeId": "n11"
      },
      "n11": {
        "id": "n11",
        "speakerId": "meguru",
        "text": "……今天的事我也会好好藏在心底的……好吗，制作人！"
      }
    }
  },
  "annotations": [],
