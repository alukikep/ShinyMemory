{
  "id": "draft.dialogue.luca.third",
  "kind": "dialogue",
  "title": "第三次，她发着烧",
  "status": "approved",
  "version": 1,
  "rootId": "draft.dialogue.luca.third",
  "payload": {
    "id": "dialogue.luca.third",
    "idolId": "luca",
    "startNodeId": "1",
    "nodes": {
      "1": {
        "id": "1",
        "text": "走廊里有声音。屋里有人在走来走去，脚步很乱。",
        "nextNodeId": "2"
      },
      "2": {
        "id": "2",
        "speakerId": "producer",
        "text": "……ルカ？",
        "nextNodeId": "3"
      },
      "3": {
        "id": "3",
        "speakerId": "luca",
        "text": "……",
        "nextNodeId": "4"
      },
      "4": {
        "id": "4",
        "speakerId": "luca",
        "text": "别来了……",
        "nextNodeId": "5"
      },
      "5": {
        "id": "5",
        "speakerId": "luca",
        "text": "来多少次都没用的────────",
        "nextNodeId": "6"
      },
      "6": {
        "id": "6",
        "speakerId": "luca",
        "text": "……头……好重",
        "nextNodeId": "7"
      },
      "7": {
        "id": "7",
        "speakerId": "producer",
        "text": "……你发烧了？",
        "nextNodeId": "8"
      },
      "8": {
        "id": "8",
        "speakerId": "luca",
        "text": "滚……！",
        "nextNodeId": "9"
      },
      "9": {
        "id": "9",
        "speakerId": "luca",
        "text": "吵……重────────",
        "nextNodeId": "10"
      },
      "10": {
        "id": "10",
        "speakerId": "luca",
        "text": "────────烫……。吵死了",
        "nextNodeId": "11"
      },
      "11": {
        "id": "11",
        "speakerId": "luca",
        "text": "────────消失吧",
        "nextNodeId": "12"
      },
      "12": {
        "id": "12",
        "speakerId": "producer",
        "text": "ルカ……？　────啊……！",
        "nextNodeId": "13"
      },
      "13": {
        "id": "13",
        "speakerId": "hazuki",
        "text": "────────！",
        "nextNodeId": "14"
      },
      "14": {
        "id": "14",
        "speakerId": "hazuki",
        "text": "制、制作人先生……这孩子，头发────────！",
        "nextNodeId": "15"
      },
      "15": {
        "id": "15",
        "text": "门开了。她抓着门框，另一只手里是剪刀，脚边的地板上落着一小堆头发。",
        "nextNodeId": "16"
      },
      "16": {
        "id": "16",
        "speakerId": "luca",
        "text": "要说多少遍才懂啊…………别来了……！",
        "nextNodeId": "17"
      },
      "17": {
        "id": "17",
        "speakerId": "luca",
        "text": "再来，我就剪………………",
        "nextNodeId": "18"
      },
      "18": {
        "id": "18",
        "speakerId": "luca",
        "text": "要怎样才肯放过我啊…………！",
        "nextNodeId": "19"
      },
      "19": {
        "id": "19",
        "speakerId": "luca",
        "text": "你来一次………………就会少一点啊………………",
        "nextNodeId": "20"
      },
      "20": {
        "id": "20",
        "speakerId": "luca",
        "text": "好痛",
        "nextNodeId": "21"
      },
      "21": {
        "id": "21",
        "speakerId": "luca",
        "text": "重要的东西…………一点一点…………！",
        "nextNodeId": "22"
      },
      "22": {
        "id": "22",
        "speakerId": "producer",
        "text": "……！别动那个────！",
        "nextNodeId": "23"
      },
      "23": {
        "id": "23",
        "speakerId": "hazuki",
        "text": "────嗯，好像还有点烧……",
        "nextNodeId": "24"
      },
      "24": {
        "id": "24",
        "speakerId": "hazuki",
        "text": "让她到里面躺下来。保险起见，还是去医院。",
        "nextNodeId": "25"
      },
      "25": {
        "id": "25",
        "speakerId": "producer",
        "text": "……好！",
        "nextNodeId": "26"
      },
      "26": {
        "id": "26",
        "speakerId": "luca",
        "text": "要怎样",
        "nextNodeId": "27"
      },
      "27": {
        "id": "27",
        "speakerId": "luca",
        "text": "才不会管我啊",
        "nextNodeId": "28"
      },
      "28": {
        "id": "28",
        "speakerId": "luca",
        "text": "────────别放着不管啊",
        "nextNodeId": "29"
      },
      "29": {
        "id": "29",
        "speakerId": "luca",
        "text": "…………已经…………别再夺走了………………",
        "nextNodeId": "30"
      },
      "30": {
        "id": "30",
        "speakerId": "luca",
        "text": "你如果要连我一起夺走的话…………",
        "nextNodeId": "31"
      },
      "31": {
        "id": "31",
        "speakerId": "luca",
        "text": "只要攥紧，我就不再是我了啊────────！",
        "nextNodeId": "32"
      },
      "32": {
        "id": "32",
        "speakerId": "producer",
        "text": "────────",
        "nextNodeId": "33"
      },
      "33": {
        "id": "33",
        "speakerId": "producer",
        "text": "不是什么夺走、被夺走的问题────",
        "nextNodeId": "34"
      },
      "34": {
        "id": "34",
        "speakerId": "producer",
        "text": "……不是那样。",
        "nextNodeId": "35"
      },
      "35": {
        "id": "35",
        "speakerId": "producer",
        "text": "是想让你抓住────",
        "nextNodeId": "36"
      },
      "36": {
        "id": "36",
        "speakerId": "producer",
        "text": "想让你抓住别的什么……能让你幸福起来的东西。",
        "nextNodeId": "37"
      },
      "37": {
        "id": "37",
        "speakerId": "producer",
        "text": "我想帮上你的忙────我是这么想的────────！",
        "nextNodeId": "38"
      },
      "38": {
        "id": "38",
        "speakerId": "luca",
        "text": "────────────",
        "nextNodeId": "39"
      },
      "39": {
        "id": "39",
        "speakerId": "hazuki",
        "text": "来，擦擦汗吧……？",
        "nextNodeId": "40"
      },
      "40": {
        "id": "40",
        "speakerId": "hazuki",
        "text": "放心吧……慢慢呼吸，躺下来────",
        "nextNodeId": "41"
      },
      "41": {
        "id": "41",
        "text": "她的手一直攥着那截剪刀，很久以后才松开。"
      }
    }
  },
  "annotations": [],
