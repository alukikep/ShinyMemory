{
  "id": "draft.dialogue.meguru.coffee.cup",
  "kind": "dialogue",
  "title": "咖啡 · 砂糖和牛奶",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.meguru.coffee.cup",
  "payload": {
    "id": "dialogue.meguru.coffee.cup",
    "idolId": "meguru",
    "startNodeId": "n01",
    "nodes": {
      "n01": {
        "id": "n01",
        "speakerId": "meguru",
        "text": "差不多要工作了吧？我去给你泡热咖啡。",
        "nextNodeId": "n02"
      },
      "n02": {
        "id": "n02",
        "speakerId": "meguru",
        "text": "啊，砂糖和牛奶要加多少……？",
        "nextNodeId": "n03"
      },
      "n03": {
        "id": "n03",
        "text": "你说不用加，直接喝就好。",
        "nextNodeId": "n04"
      },
      "n04": {
        "id": "n04",
        "speakerId": "meguru",
        "text": "诶！是这样吗！？可是你明明一直在工作……",
        "nextNodeId": "n05"
      },
      "n05": {
        "id": "n05",
        "speakerId": "meguru",
        "text": "啊！嗯，嗯嗯，偶尔也需要休息呢……我会对叶月保密的……",
        "nextNodeId": "n06"
      },
      "n06": {
        "id": "n06",
        "text": "你说她是不是搞错了什么。你说的是会在其他天休息。",
        "nextNodeId": "n07"
      },
      "n07": {
        "id": "n07",
        "speakerId": "meguru",
        "text": "咦？这样吗？呜……我还以为你偶尔偷个懒……",
        "nextNodeId": "n08"
      },
      "n08": {
        "id": "n08",
        "speakerId": "meguru",
        "text": "对不起！制作人！",
        "nextNodeId": "n09"
      },
      "n09": {
        "id": "n09",
        "text": "她慌忙去准备，走到门口又回头。",
        "nextNodeId": "n10"
      },
      "n10": {
        "id": "n10",
        "speakerId": "meguru",
        "text": "……今天你可以午睡的。",
        "nextNodeId": "n11"
      },
      "n11": {
        "id": "n11",
        "speakerId": "meguru",
        "text": "因为我是在离你最近的地方看你努力的！",
        "nextNodeId": "n12"
      },
      "n12": {
        "id": "n12",
        "speakerId": "meguru",
        "text": "如果制作人累了的话，我可以陪你聊天，行程我也可以自己好好确认！"
      }
    }
  },
  "annotations": [],
