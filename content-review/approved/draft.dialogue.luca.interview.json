{
  "id": "draft.dialogue.luca.interview",
  "kind": "dialogue",
  "title": "采访中途，她停住了",
  "status": "approved",
  "version": 1,
  "rootId": "draft.dialogue.luca.interview",
  "payload": {
    "id": "dialogue.luca.interview",
    "idolId": "luca",
    "startNodeId": "1",
    "nodes": {
      "1": {
        "id": "1",
        "text": "录音棚的角落里摆了一张桌子和两把椅子。采访的人已经坐好了。",
        "nextNodeId": "2"
      },
      "2": {
        "id": "2",
        "speakerId": "luca",
        "text": "声乐和舞蹈…………练习，不能落下────",
        "nextNodeId": "3"
      },
      "3": {
        "id": "3",
        "speakerId": "producer",
        "text": "……",
        "nextNodeId": "4"
      },
      "4": {
        "id": "4",
        "text": "采访的人翻了一页纸，换了个问题。",
        "nextNodeId": "5"
      },
      "5": {
        "id": "5",
        "speakerId": "luca",
        "text": "……辛苦？",
        "nextNodeId": "6"
      },
      "6": {
        "id": "6",
        "text": "对方说的是：工作上有没有什么辛苦的事、难过的事。",
        "nextNodeId": "7"
      },
      "7": {
        "id": "7",
        "speakerId": "luca",
        "text": "………………",
        "nextNodeId": "8"
      },
      "8": {
        "id": "8",
        "speakerId": "luca",
        "text": "……难过的，事……",
        "nextNodeId": "9"
      },
      "9": {
        "id": "9",
        "speakerId": "luca",
        "text": "────────────────",
        "nextNodeId": "10"
      },
      "10": {
        "id": "10",
        "text": "她没有再说下去。桌边的人叫了她两声，她才像被碰到一样抬起眼睛。",
        "nextNodeId": "11"
      },
      "11": {
        "id": "11",
        "speakerId": "producer",
        "text": "ルカ？　ルカ────？",
        "nextNodeId": "12"
      },
      "12": {
        "id": "12",
        "speakerId": "luca",
        "text": "……诶？",
        "nextNodeId": "13"
      },
      "13": {
        "id": "13",
        "speakerId": "producer",
        "text": "没事吧？还在采访中间。",
        "nextNodeId": "14"
      },
      "14": {
        "id": "14",
        "speakerId": "producer",
        "text": "……不好意思，稍等一下。",
        "nextNodeId": "15"
      },
      "15": {
        "id": "15",
        "text": "对方说可以改天重来一次。",
        "nextNodeId": "16"
      },
      "16": {
        "id": "16",
        "speakerId": "luca",
        "text": "为什么──────",
        "nextNodeId": "17"
      },
      "17": {
        "id": "17",
        "speakerId": "producer",
        "text": "诶……？",
        "nextNodeId": "18"
      },
      "18": {
        "id": "18",
        "speakerId": "luca",
        "text": "为什么要……重来啊。",
        "nextNodeId": "19"
      },
      "19": {
        "id": "19",
        "speakerId": "luca",
        "text": "我明明……在回答吧……",
        "nextNodeId": "20"
      },
      "20": {
        "id": "20",
        "speakerId": "luca",
        "text": "我明明在回答啊……",
        "nextNodeId": "21"
      },
      "21": {
        "id": "21",
        "speakerId": "luca",
        "text": "是要删掉吗……",
        "nextNodeId": "22"
      },
      "22": {
        "id": "22",
        "speakerId": "luca",
        "text": "──────继续",
        "nextNodeId": "23"
      },
      "23": {
        "id": "23",
        "speakerId": "producer",
        "text": "可是……",
        "nextNodeId": "24"
      },
      "24": {
        "id": "24",
        "speakerId": "producer",
        "text": "…………是啊。",
        "nextNodeId": "25"
      },
      "25": {
        "id": "25",
        "speakerId": "producer",
        "text": "……如果方便的话，能让我们继续吗？",
        "nextNodeId": "26"
      },
      "26": {
        "id": "26",
        "speakerId": "producer",
        "text": "还有，刚才采到的那部分，也请照原样用。",
        "nextNodeId": "27"
      },
      "27": {
        "id": "27",
        "text": "对方确认了两遍，才把录音笔又打开。",
        "nextNodeId": "28"
      },
      "28": {
        "id": "28",
        "speakerId": "producer",
        "text": "……ルカ。辛苦了。",
        "nextNodeId": "29"
      },
      "29": {
        "id": "29",
        "speakerId": "luca",
        "text": "…………",
        "nextNodeId": "30"
      },
      "30": {
        "id": "30",
        "speakerId": "luca",
        "text": "……没什么。",
        "nextNodeId": "31"
      },
      "31": {
        "id": "31",
        "speakerId": "luca",
        "text": "被问到什么……我就答了什么。",
        "nextNodeId": "32"
      },
      "32": {
        "id": "32",
        "speakerId": "luca",
        "text": "答了而已。就那么……",
        "nextNodeId": "33"
      },
      "33": {
        "id": "33",
        "speakerId": "producer",
        "text": "……你的脸色不太好。",
        "nextNodeId": "34"
      },
      "34": {
        "id": "34",
        "speakerId": "luca",
        "text": "别管我……",
        "nextNodeId": "35"
      },
      "35": {
        "id": "35",
        "speakerId": "luca",
        "text": "不是你该操心的事……",
        "nextNodeId": "36"
      },
      "36": {
        "id": "36",
        "speakerId": "producer",
        "text": "……live，能行吗？",
        "nextNodeId": "37"
      },
      "37": {
        "id": "37",
        "speakerId": "luca",
        "text": "…………会做。",
        "nextNodeId": "38"
      },
      "38": {
        "id": "38",
        "speakerId": "producer",
        "text": "可是……",
        "nextNodeId": "39"
      },
      "39": {
        "id": "39",
        "speakerId": "luca",
        "text": "会做的。",
        "nextNodeId": "40"
      },
      "40": {
        "id": "40",
        "speakerId": "luca",
        "text": "我说会做──────"
      }
    }
  },
  "annotations": [],
