{
  "id": "draft.dialogue.meguru.coffee",
  "kind": "dialogue",
  "title": "一杯咖啡",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.meguru.coffee",
  "payload": {
    "id": "dialogue.meguru.coffee",
    "idolId": "meguru",
    "startNodeId": "1-n01",
    "nodes": {
      "1-n01": {
        "id": "1-n01",
        "text": "事务所的灯还亮着。桌上摊着文件，你趴在上面睡着了。",
        "nextNodeId": "1-n02"
      },
      "1-n02": {
        "id": "1-n02",
        "speakerId": "meguru",
        "text": "制作人，制作人……",
        "nextNodeId": "1-n03"
      },
      "1-n03": {
        "id": "1-n03",
        "text": "你睁开眼。肩上盖着一条毯子。",
        "nextNodeId": "1-n04"
      },
      "1-n04": {
        "id": "1-n04",
        "speakerId": "meguru",
        "text": "早安！",
        "nextNodeId": "1-n05"
      },
      "1-n05": {
        "id": "1-n05",
        "text": "你说早安，问这条毯子是哪儿来的。",
        "nextNodeId": "1-n06"
      },
      "1-n06": {
        "id": "1-n06",
        "speakerId": "meguru",
        "text": "是叶月放的。她还说她试着叫醒你，但你没醒。",
        "nextNodeId": "1-n07"
      },
      "1-n07": {
        "id": "1-n07",
        "speakerId": "meguru",
        "text": "工作很忙吧……在家里好好睡一觉更好啊——",
        "nextNodeId": "1-n08"
      },
      "1-n08": {
        "id": "1-n08",
        "speakerId": "meguru",
        "text": "制作人，我最近都没看到你休息啊？",
        "nextNodeId": "2-n01"
      },
      "2-n01": {
        "id": "2-n01",
        "speakerId": "meguru",
        "text": "难道……因为我才这么忙？",
        "nextNodeId": "2-n02"
      },
      "2-n02": {
        "id": "2-n02",
        "speakerId": "meguru",
        "text": "又来看我练习，又来陪我说话……",
        "nextNodeId": "2-n03"
      },
      "2-n03": {
        "id": "2-n03",
        "text": "她低着头，手指在毯子边缘来回捏。",
        "choices": [
          {
            "label": "不是你的错",
            "nextNodeId": "2-n04a",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "trust",
                "tier": 1
              }
            ]
          },
          {
            "label": "我很开心，没问题的",
            "nextNodeId": "2-n04b",
            "effects": [
              {
                "kind": "sharedStat",
                "stat": "stress",
                "delta": -2
              }
            ]
          },
          {
            "label": "其实我有休息",
            "nextNodeId": "2-n04c",
            "effects": [
              {
                "kind": "attributeExp",
                "ref": "insight",
                "tier": 1
              }
            ]
          }
        ]
      },
      "2-n04a": {
        "id": "2-n04a",
        "text": "你说很抱歉让她这么想。她抬起头。",
        "nextNodeId": "2-n05"
      },
      "2-n04b": {
        "id": "2-n04b",
        "speakerId": "meguru",
        "text": "开心是开心……可是那样也不行啊！",
        "nextNodeId": "2-n05"
      },
      "2-n04c": {
        "id": "2-n04c",
        "speakerId": "meguru",
        "text": "骗人。桌上都是文件。",
        "nextNodeId": "2-n05"
      },
      "2-n05": {
        "id": "2-n05",
        "text": "你说，巡每天都能坚持完成那么严格的课程吧。站在舞台上发光是她的工作，在背后支持她是你的工作。",
        "nextNodeId": "2-n06"
      },
      "2-n06": {
        "id": "2-n06",
        "speakerId": "meguru",
        "text": "嗯……",
        "nextNodeId": "2-n07"
      },
      "2-n07": {
        "id": "2-n07",
        "text": "你说不过会尽量不让她担心。她用力点头。",
        "nextNodeId": "2-n08"
      },
      "2-n08": {
        "id": "2-n08",
        "speakerId": "meguru",
        "text": "嗯！要快点好好休息……不是因为我在担心，这是为了制作人的身体哦？",
        "nextNodeId": "3-n01"
      },
      "3-n01": {
        "id": "3-n01",
        "speakerId": "meguru",
        "text": "差不多要工作了吧？我去给你泡热咖啡。",
        "nextNodeId": "3-n02"
      },
      "3-n02": {
        "id": "3-n02",
        "speakerId": "meguru",
        "text": "啊，砂糖和牛奶要加多少……？",
        "nextNodeId": "3-n03"
      },
      "3-n03": {
        "id": "3-n03",
        "text": "你说不用加，直接喝就好。",
        "nextNodeId": "3-n04"
      },
      "3-n04": {
        "id": "3-n04",
        "speakerId": "meguru",
        "text": "诶！是这样吗！？可是你明明一直在工作……",
        "nextNodeId": "3-n05"
      },
      "3-n05": {
        "id": "3-n05",
        "speakerId": "meguru",
        "text": "啊！嗯，嗯嗯，偶尔也需要休息呢……我会对叶月保密的……",
        "nextNodeId": "3-n06"
      },
      "3-n06": {
        "id": "3-n06",
        "text": "你说她是不是搞错了什么。你说的是会在其他天休息。",
        "nextNodeId": "3-n07"
      },
      "3-n07": {
        "id": "3-n07",
        "speakerId": "meguru",
        "text": "咦？这样吗？呜……我还以为你偶尔偷个懒……",
        "nextNodeId": "3-n08"
      },
      "3-n08": {
        "id": "3-n08",
        "speakerId": "meguru",
        "text": "对不起！制作人！",
        "nextNodeId": "3-n09"
      },
      "3-n09": {
        "id": "3-n09",
        "text": "她慌忙去准备，走到门口又回头。",
        "nextNodeId": "3-n10"
      },
      "3-n10": {
        "id": "3-n10",
        "speakerId": "meguru",
        "text": "……今天你可以午睡的。",
        "nextNodeId": "3-n11"
      },
      "3-n11": {
        "id": "3-n11",
        "speakerId": "meguru",
        "text": "因为我是在离你最近的地方看你努力的！",
        "nextNodeId": "3-n12"
      },
      "3-n12": {
        "id": "3-n12",
        "speakerId": "meguru",
        "text": "如果制作人累了的话，我可以陪你聊天，行程我也可以自己好好确认！"
      }
    }
  },
  "annotations": [],
