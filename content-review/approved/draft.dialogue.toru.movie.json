        "text": "——",
        "nextNodeId": "145"
      },
      "145": {
        "id": "145",
        "speakerId": "producer",
        "text": "……对不起。我觉得是名场面……失礼，电话。",
        "nextNodeId": "146"
      },
      "146": {
        "id": "146",
        "speakerId": "toru",
        "text": "啊……嗯。",
        "nextNodeId": "147"
      },
      "147": {
        "id": "147",
        "speakerId": "toru",
        "text": "——放映中请将",
        "nextNodeId": "148"
      },
      "148": {
        "id": "148",
        "speakerId": "toru",
        "text": "手机调成静音，或关闭电源——"
      }
