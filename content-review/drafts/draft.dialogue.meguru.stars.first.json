  "title": "星空 · 抬头",
  "status": "review",
  "version": 1,
  "rootId": "draft.dialogue.meguru.stars.first",
  "payload": {
    "id": "dialogue.meguru.stars.first",
    "idolId": "meguru",
    "startNodeId": "n01",
    "nodes": {
      "n01": {
        "id": "n01",
        "text": "晚上的公园。路灯很暗，抬头能看到星星。",
        "nextNodeId": "n02"
      },
      "n02": {
        "id": "n02",
        "speakerId": "meguru",
        "text": "哇——！制作人快看！",
        "nextNodeId": "n03"
      },
      "n03": {
        "id": "n03",
        "speakerId": "meguru",
        "text": "星星真的很漂亮……！",
        "nextNodeId": "n04"
      },
      "n04": {
        "id": "n04",
        "speakerId": "meguru",
        "text": "好多一闪一闪的！诶嘿嘿，好像我们一样。",
        "nextNodeId": "n05"
      },
      "n05": {
        "id": "n05",
        "text": "你问她指的是 illumination STARS 吗。",
        "nextNodeId": "n06"
      },
      "n06": {
        "id": "n06",
        "speakerId": "meguru",
        "text": "对！诶嘿嘿……"
      }
    }
  },
