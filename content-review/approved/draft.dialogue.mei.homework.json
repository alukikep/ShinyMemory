      "1": {
        "id": "1",
        "speakerId": "mei",
        "text": "呐，制作人，能不能让うち在这里写作业！",
        "nextNodeId": "2"
      },
      "2": {
        "id": "2",
        "speakerId": "producer",
        "text": "？　啊，可以啊。",
        "nextNodeId": "3"
      },
      "3": {
        "id": "3",
        "speakerId": "mei",
        "text": "真的！？帮大忙了～……谢啦，制作人。",
        "nextNodeId": "4"
      },
      "4": {
        "id": "4",
        "speakerId": "mei",
        "text": "……好嘞～！那就，赶紧开始吧！",
        "nextNodeId": "5"
      },
      "5": {
        "id": "5",
        "speakerId": "mei",
        "text": "…………",
        "nextNodeId": "6"
      },
      "6": {
        "id": "6",
        "speakerId": "producer",
        "text": "（她把参考书摊开，然后就不动了。）",
        "nextNodeId": "7"
      },
      "7": {
        "id": "7",
        "speakerId": "producer",
        "text": "愛依？",
        "nextNodeId": "8"
      },
      "8": {
        "id": "8",
        "speakerId": "mei",
        "text": "……这题，完全看不懂。",
        "nextNodeId": "9"
      },
      "9": {
        "id": "9",
        "speakerId": "mei",
        "text": "うち，英语和阅读理解都不行。",
        "nextNodeId": "10"
      },
      "10": {
        "id": "10",
        "speakerId": "producer",
        "text": "（说得很干脆，一点也不遮掩。）",
        "choices": [
          {
            "label": "先看题，再读文章。",
            "nextNodeId": "100"
          },
          {
            "label": "从简单的开始。",
            "nextNodeId": "110"
          },
          {
            "label": "我陪你一起看。",
            "nextNodeId": "120"
          }
        ]
      },
      "100": {
        "id": "100",
        "speakerId": "mei",
        "text": "先看题……？",
