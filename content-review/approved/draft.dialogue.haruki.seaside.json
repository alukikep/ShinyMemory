{
  "id": "draft.dialogue.haruki.seaside",
  "kind": "dialogue",
  "title": "收工后她想在海边走走",
  "status": "approved",
  "version": 1,
  "rootId": "draft.dialogue.haruki.seaside",
  "payload": {
    "id": "dialogue.haruki.seaside",
    "idolId": "haruki",
    "startNodeId": "1",
    "nodes": {
      "1": {
        "id": "1",
        "speakerId": "producer",
        "text": "──はるき，可以解散了，回去吧。",
        "nextNodeId": "2"
      },
      "2": {
        "id": "2",
        "speakerId": "haruki",
        "text": "啊……好────",
        "nextNodeId": "3"
      },
      "3": {
        "id": "3",
        "speakerId": "haruki",
        "text": "…………",
        "nextNodeId": "4"
      },
      "4": {
        "id": "4",
        "speakerId": "haruki",
        "text": "那个，制作人先生。我……可以留在这里吗。",
        "nextNodeId": "5"
      },
      "5": {
        "id": "5",
        "speakerId": "producer",
        "text": "……诶。",
        "nextNodeId": "6"
      },
      "6": {
        "id": "6",
        "speakerId": "haruki",
        "text": "之后也没有别的事，机会难得，想在这附近走走────",
        "nextNodeId": "7"
      },
      "7": {
        "id": "7",
        "speakerId": "haruki",
        "text": "听说海边有各种各样的小店……可、可以吗……？",
        "nextNodeId": "8"
      },
      "8": {
        "id": "8",
        "speakerId": "producer",
        "text": "那个────",
        "nextNodeId": "9"
      },
      "9": {
        "id": "9",
        "text": "海边的露天座位。风很舒服。",
        "nextNodeId": "10"
      },
      "10": {
        "id": "10",
        "speakerId": "haruki",
        "text": "哇……好棒的地方……海风好舒服……！",
        "nextNodeId": "11"
      },
      "11": {
        "id": "11",
        "speakerId": "producer",
        "text": "幸好有空位。",
        "nextNodeId": "12"
      },
      "12": {
        "id": "12",
        "speakerId": "haruki",
        "text": "是……！",
        "nextNodeId": "13"
      },
      "13": {
        "id": "13",
        "speakerId": "haruki",
        "text": "对不起，结果还是让您陪我任性了……",
        "nextNodeId": "14"
      },
      "14": {
        "id": "14",
        "speakerId": "producer",
        "text": "哈哈，没关系。虽然只能到我得走的时候──",
        "nextNodeId": "15"
      },
      "15": {
        "id": "15",
        "speakerId": "producer",
        "text": "我也很高兴能在这里喝杯茶。",
        "nextNodeId": "16"
      },
      "16": {
        "id": "16",
        "speakerId": "haruki",
        "text": "这里每张桌上都有一个水壶呢……！",
        "nextNodeId": "17"
      },
      "17": {
        "id": "17",
        "speakerId": "haruki",
        "text": "我来倒～",
        "nextNodeId": "18"
      },
      "18": {
        "id": "18",
        "speakerId": "producer",
        "text": "哦，谢谢。",
        "nextNodeId": "19"
      },
      "19": {
        "id": "19",
        "speakerId": "haruki",
        "text": "哇哇……！对不起，倒太猛了……！",
        "nextNodeId": "20"
      },
      "20": {
        "id": "20",
        "speakerId": "producer",
        "text": "哦哦，没事，只洒了一点……",
        "nextNodeId": "21"
      },
      "21": {
        "id": "21",
        "speakerId": "haruki",
        "text": "纸巾纸巾……",
        "nextNodeId": "22"
      },
      "22": {
        "id": "22",
        "speakerId": "haruki",
        "text": "水，我重新倒。",
        "nextNodeId": "23"
      },
      "23": {
        "id": "23",
        "speakerId": "producer",
        "text": "哎，はるき，手劲──",
        "nextNodeId": "24"
      },
      "24": {
        "id": "24",
        "speakerId": "haruki",
        "text": "哇啊……！",
        "nextNodeId": "25"
      },
      "25": {
        "id": "25",
        "speakerId": "haruki",
        "text": "溢出来了……",
        "nextNodeId": "26"
      },
      "26": {
        "id": "26",
        "speakerId": "haruki",
        "text": "对不起……我好像有点飘了。",
        "nextNodeId": "27"
      },
      "27": {
        "id": "27",
        "speakerId": "producer",
        "text": "哈哈，那我来倒吧。",
        "nextNodeId": "28"
      },
      "28": {
        "id": "28",
        "speakerId": "haruki",
        "text": "对不起……！",
        "nextNodeId": "29"
      },
      "29": {
        "id": "29",
        "speakerId": "haruki",
        "text": "为什么会变成这样呢……",
        "nextNodeId": "30"
      },
      "30": {
        "id": "30",
        "speakerId": "producer",
        "text": "杯子小，水壶又挺重的嘛。",
        "nextNodeId": "31"
      },
      "31": {
        "id": "31",
        "speakerId": "producer",
        "text": "──来，请。"
      }
    }
  },
